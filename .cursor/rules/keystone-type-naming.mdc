    ```

### 3.6. Schema Plugins (`lib/schemaPlugins/`)

* **General Plugin Type**:
    ```typescript
    // General type for a Mongoose schema plugin function
    type KeystoneSchemaPlugin = (schema: mongoose.Schema, options: any) => void;
    ```
* **Specific Plugins**: Define options interfaces and use the general type.
    ```typescript
    interface KeystoneSortablePluginOptions {
        list: KeystoneList;
        path?: string;
        // ... other options
    }
    type KeystoneSortablePlugin = (schema: mongoose.Schema, options: KeystoneSortablePluginOptions) => void;

    interface KeystoneTrackPluginOptions {
        list: KeystoneList;
        fields: KeystoneListOptions['track']; // Reuse existing type
        // ... other options
    }
    type KeystoneTrackPlugin = (schema: mongoose.Schema, options: KeystoneTrackPluginOptions) => void;

    interface KeystoneAutokeyPluginOptions {
        list: KeystoneList;
        path: string;
        from: string | string[];
        // ... other options (unique, separator etc)
    }
    type KeystoneAutokeyPlugin = (schema: mongoose.Schema, options: KeystoneAutokeyPluginOptions) => void;

    interface KeystoneHistoryPluginOptions {
        list: KeystoneList;
        path?: string;
        // ... other options
    }
    type KeystoneHistoryPlugin = (schema: mongoose.Schema, options: KeystoneHistoryPluginOptions) => void;

    // For plugins defining schema methods (getRelated, populateRelated):
    // These add methods to mongoose.Document, handled within the plugin logic.
    // No specific top-level type needed, focus on the plugin function itself.

    // For transform plugin:
    interface KeystoneTransformPluginOptions {
        // Options for transform plugin
    }
    type KeystoneTransformPlugin = (schema: mongoose.Schema, options: KeystoneTransformPluginOptions) => void;

    ```

### 3.7. Content Types (`lib/content/`)

* **`type.js` (Base Type)**:
    ```typescript
    interface KeystoneContentType {
        // Define common methods based on source (e.g., register, format)
        register(list: KeystoneList, path: string, options: any): void;
        format(item: KeystoneDocument, options?: any): string;
        // ... other common methods
    }
    ```
* **Specific Content Types**: Extend the base type.
    ```typescript
    interface KeystoneHtmlContentType extends KeystoneContentType {
        // HTML specific methods/properties
    }
    interface KeystoneTextContentType extends KeystoneContentType {
        // Text specific methods/properties
    }
    ```
* **`page.js`**: Class or interface for content pages.
    ```typescript
    interface KeystoneContentPageOptions { /* ... */ }
    interface KeystoneContentPage {
        // Properties like sections, content, data
        // Methods like load, render
        constructor(options: KeystoneContentPageOptions): void;
        load(callback: (err?: any) => void): void;
        render(req: express.Request, res: express.Response, locals?: any, callback?: (err: any, html: string) => void): void;
    }
    type KeystoneContentPageConstructor = new (options: KeystoneContentPageOptions) => KeystoneContentPage;
    ```
* **`index.js` (Content Module Exports)**:
    ```typescript
    interface KeystoneContentModule {
        types: Record<string, KeystoneContentType>;
        Type: KeystoneContentType; // Base type constructor/class?
        Page: KeystoneContentPageConstructor;
    }
    // This matches Keystone['content']
    ```

### 3.8. Storage (`lib/storage/`)

* **`index.js` (Storage Module Exports)**:
    ```typescript
    interface KeystoneStorageModule {
        Storage: typeof KeystoneStorage; // The main Storage class constructor
        Adapters: {
            FS: typeof FileSystemStorageAdapter; // Assuming class defined below
            S3?: any; // Add other adapters if used
            Azure?: any;
        };
    }
    // This matches Keystone['Storage']

    // Interface for the Storage class instance
    interface KeystoneStorageInstance {
        options: any;
        adapter: KeystoneFileStorage; // Using existing type, make more generic if needed
        // methods like upload, remove etc.
    }
    // Type for the Storage class constructor
    type KeystoneStorage = new (options: any) => KeystoneStorageInstance;
    ```
* **`adapters/fs/index.js`**: File System Adapter (Class). `KeystoneFileStorage` already covers the interface. Define options.
    ```typescript
    interface KeystoneFsAdapterOptions {
        path: string;
        src?: string; // URL base path
        uploadPath?: string; // Subdir within path
        generateFilename?: (file: any, attempt: number) => string;
        // ... other FS options
    }
    // Assuming the FS Adapter is a class implementing KeystoneFileStorage
    type FileSystemStorageAdapter = new (options: KeystoneFsAdapterOptions) => KeystoneFileStorage;

    ```

### 3.9. Uploads (`lib/uploads.js`)

* Module providing upload handling utilities.
    ```typescript
    interface KeystoneUploadedFile {
        name: string;
        mimetype: string;
        path: string;
        size: number;
        // ... other properties added by multer or processing
    }

    interface KeystoneUploadsModule {
        getRequestFiles(req: express.Request): Record<string, KeystoneUploadedFile | KeystoneUploadedFile[]> | undefined;
        // ... other potential utility functions
    }
    ```

### 3.10. List Methods (`lib/list/*.js`)

* **Goal:** Refine the *existing method signatures* within the `KeystoneList` class definition, rather than creating new top-level types for each file.
* **Process:** For each method (e.g., `getCSVData`, `paginate`, `updateItem`, `getUniqueValue`), examine the corresponding source file (`lib/list/getCSVData.js`, etc.) to define more specific types for `options`, `filters`, `callback` arguments, and return values.
* **Examples:**
    ```typescript
    // In KeystoneList definition:

    // Example for getCSVData
    interface KeystoneGetCsvOptions {
        list?: KeystoneList;
        query?: any; // Mongoose Query
        filters?: Record<string, any>;
        search?: string;
        columns?: string | string[] | Array<{ path: string; label?: string; /*...*/ }>;
        // ... other options from source
    }
    getCSVData(options: KeystoneGetCsvOptions, user: any, callback: (err: any, csvData: string) => void): void;

    // Example for paginate
    interface KeystonePaginateOptions {
        page?: number | string;
        perPage?: number;
        maxPages?: number;
        filters?: Record<string, any>;
        // ... maybe include query? Based on source
    }
    interface KeystonePaginateResults<T = KeystoneDocument> {
        total: number;
        results: T[];
        currentPage: number;
        totalPages: number;
        pages: number[];
        previous: number | false;
        next: number | false;
        first: number;
        last: number;
    }
    paginate(options: KeystonePaginateOptions, callback: (err: any, results: KeystonePaginateResults) => void): void;

    // Example for updateItem
    interface KeystoneUpdateItemOptions {
        files?: Record<string, KeystoneUploadedFile | KeystoneUploadedFile[]>;
        user?: KeystoneDocument; // Assuming user model document
        // ... other potential options
    }
    updateItem(item: KeystoneDocument, data: any, options: KeystoneUpdateItemOptions, callback: (err: any, updatedItem: KeystoneDocument) => void): void;
    ```

